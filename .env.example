# ==============================================================================
# MARTECH ENGINEER DYNAMIC MEDIA AJO - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# AI PROVIDERS (Supports comma-separated keys for auto-rotation)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here

# ADOBE FIREFLY SERVICES (EMBEDDED - BANK REPO CONNECTED MODE)
FIREFLY_CLIENT_ID=your_adobe_client_id
FIREFLY_CLIENT_SECRET=your_adobe_client_secret
FIREFLY_ORG_ID=your_adobe_org_id

# GOOGLE MAPS / PLACES API
GOOGLE_MAPS_API_KEY=your_google_maps_key

# MONGODB ATLAS (GOVERNANCE, MANDAMIENTOS, INITIATIVES & CATALOG)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ajo-cdp-meta-db?retryWrites=true&w=majority
DB_NAME=ajo-cdp-meta-db

# ADOBE EXPERIENCE PLATFORM (AEP / CDP) & META AJO INTEGRATION
CDP_URL=https://dcs.adobedc.net/collection/...
CDP_FLOW_ID=your_cdp_flow_id
META_FLOW_ID=your_meta_flow_id

# AEM INSTANCE & DYNAMIC MEDIA DELIVERY
AEM_HOST=localhost
AEM_PORT=4502
AEM_USER=admin
AEM_PASSWORD=admin
DYNAMIC_MEDIA_DELIVERY_HOST=delivery-p187030-e1959235.adobeaemcloud.com

# MCP & AGENT HUB PORTS
PORT=3000
MCP_PORT=3001
FLOW_STUDIO_PORT=3002
NODE_ENV=development
